# Use a SQL Server login and make sure SQL Server accepts TCP connections from Docker.
# On Windows, host.docker.internal points to the Windows host machine.
DB_CONNECTION_STRING='Server=host.docker.internal,1433;Database=YOUR_DATABASE;User Id=YOUR_SQL_LOGIN;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;Encrypt=False'

# Replace this with a random value containing at least 32 characters.
JWT_KEY=replace-this-with-a-random-secret-at-least-32-characters-long

# Optional. Leave blank if you do not need email notifications in the Docker run.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
